{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4-T01 evaluation freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "freeze_status", "created_at", "coordinator_decision_reference",
    "runtime_source_sha", "collector_revision", "harness_revision",
    "dataset", "gold", "set_b", "corpus", "policy_hash", "prompt_config_hashes",
    "adaptation", "provider", "model", "model_parameters", "environment",
    "execution_mode", "timeout_seconds", "retries", "per_case_deadline_seconds",
    "gates", "budget", "execution_authorized"
  ],
  "properties": {
    "freeze_status": {"enum": ["FREEZE_INCOMPLETE", "FROZEN"]},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinator_decision_reference": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "collector_revision": {"type": "string", "minLength": 1},
    "harness_revision": {"type": "string", "minLength": 1},
    "dataset": {"$ref": "#/$defs/dataset"},
    "gold": {"$ref": "#/$defs/artifact"},
    "set_b": {"$ref": "#/$defs/setB"},
    "corpus": {"$ref": "#/$defs/artifact"},
    "policy_hash": {"type": "string", "minLength": 1},
    "prompt_config_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "adaptation": {
      "type": "object", "additionalProperties": false, "required": ["state", "version"],
      "properties": {"state": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_parameters": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "minProperties": 1},
    "execution_mode": {"enum": ["LIVE", "REPLAY", "SYNTHETIC_DEV", "OFFLINE_UNIT"]},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "retries": {"type": "integer", "minimum": 0},
    "per_case_deadline_seconds": {"type": "integer", "minimum": 1},
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["quality", "sample_size", "strata", "coverage", "abort_threshold"],
      "properties": {
        "quality": {}, "sample_size": {}, "strata": {}, "coverage": {}, "abort_threshold": {}
      }
    },
    "budget": {"type": "number", "minimum": 0},
    "execution_authorized": {"type": "boolean"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "version", "hash", "reference"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "version", "hash", "reference", "eligibility"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "eligibility": {"enum": ["ELIGIBLE", "NOT_VERIFIED", "NOT_ELIGIBLE"]}
      }
    },
    "setB": {
      "type": "object", "additionalProperties": false,
      "required": ["existence", "version", "hash", "seal", "access_history"],
      "properties": {
        "existence": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1},
        "seal": {"type": "string", "minLength": 1},
        "access_history": {"type": "string", "minLength": 1}
      }
    }
  }
}
